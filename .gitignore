# Composer (se vuelven a generar en deploy)
# =======================================
/vendor/

# =======================================
# Drupal scaffold
# =======================================
/web/core/tests/

# Contrib (instalados por composer)
/web/modules/contrib/
/web/themes/contrib/

# =======================================
# Ignorar configuración local
# =======================================
/web/sites/*/settings.local.php
/web/sites/*/services.local.yml
/web/sites/development.services.yml

# =======================================
# Archivos subidos por usuarios
/web/sites/*/files/
/web/sites/*/private/

# =======================================
# Caché y temporales
/web/sites/*/files-php/
/web/sites/*/files/css/
/web/sites/*/files/js/
web/core/assets
web/core/.idea
web/core/.vscode
.idea
.vscode

# =======================================
# Backups
*.sql
*.sqlite

# =======================================
# Entorno
.env
.env.*

# =======================================
# Sistema
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db

