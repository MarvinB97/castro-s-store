# =======================================
# DDEV
# =======================================
.ddev/*
.ddev/.web-build
.ddev/.nfs
.ddev/docker-compose.override.yaml

# =======================================
# Composer
# =======================================
/vendor/

# =======================================
# Drupal scaffold (NO ignorar default.settings.php, etc)
# =======================================
/web/core/tests/

# Contrib (instalados por composer)
 /web/modules/contrib/
 /web/themes/contrib/

# =======================================
# Ignorar configuración local (sí debe ignorarse)
# =======================================
/web/sites/*/settings.local.php
/web/sites/*/services.local.yml
/web/sites/development.services.yml

# =======================================
# Archivos SUBIDOS por usuarios
/web/sites/*/files/
/web/sites/*/private/

# =======================================
# Caché y temporales
/web/sites/*/files-php/
/web/sites/*/files/css/
/web/sites/*/files/js/
.web/core/assets
/web/core/.idea
/web/core/.vscode
/.idea
/.vscode

# =======================================
# Backups
*.sql
*.sqlite

# =======================================
# Entorno
.env
.env.*

# =======================================
# Sistema
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db

# =======================================
# Opcional
/.nixpacks/

files.tar.gz
